{
  "name": "scout-connect",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "mediaryconnect.app", "custom_domain": true },
    // 内测报名站：与 API 同源，beta-page + /waitlist 一处部署
    { "pattern": "beta.mediaryconnect.app", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scout-connect",
      "database_id": "493fb312-2301-4a85-a22f-15e68460ed98"
    }
  ],
  // 到期巡检:cron 每天跑一次。dry-run 模式下只记审计,
  // 见 expiry-sweep.ts —— 真删生产资源前先验证时间边界。
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "vars": {
    "CONNECT_ROOT_DOMAIN": "mediaryconnect.app",
    "WAFFO_MERCHANT_ID": "MER_4XNDR15LYZPCUbUPbuR6R7",
    "WAFFO_STORE_ID": "STO_11zoOG0p1l1qIZIQc9dH5I",
    "WAFFO_ENVIRONMENT": "prod",
    "WAFFO_PRODUCT_QUARTER": "PROD_7P69wSLsArPk0FR21U6bB8",
    "WAFFO_PRODUCT_YEAR": "PROD_38VUdQpFXUxVCrvKVZ0NiC",
    "WAFFO_PRODUCT_TWO_YEARS": "PROD_2x5JlwkaBl7QujpMzqcjnB",
    // Turnstile sitekey —— **刻意留空以关闭人机验证门禁**。
    //
    // 为什么关:`challenges.cloudflare.com` 在中国大陆不可靠。挡住的不是脚本,
    // 是**真实用户** —— 登录页过不去 = 付不了钱,报名页过不去 = 拿不到内测
    // 用户(waitlist 长期只有 1 个报名,很可能就是被它挡住的)。
    //
    // 门禁代码**完整保留**(gate 需 sitekey + secret 成对配置才激活,
    // 见 src/routes.ts 的 turnstileGateEnabled)。想恢复只需把这行填回来 ——
    // TURNSTILE_SECRET 仍在 wrangler secret 里,不用重新申请。
    //
    // 替代防线:发信入口(/api/auth/magic、/waitlist)已加限流,
    // 见 src/rate-limit.ts 的 SIGNUP_* 参数与那里对取舍的说明。
    // "TURNSTILE_SITEKEY": "0x4AAAAAAD-wkGraJigl3YK0"
  }
  // Waffo 私钥使用 `wrangler secret put WAFFO_PRIVATE_KEY` 配置，不进入源码或 vars。
  // 缺少私钥或任一 Waffo var 即 fail closed，购买入口不会显示可用按钮。
  // EXPIRY_SWEEP_LIVE 用 `wrangler secret put` 或 dashboard 设 —— 它是行为开关
  // (true 才真删生产资源),刻意不放 vars 防误开。见 src/index.ts 的注释。
}
